rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminUser() {
      return isSignedIn() && (
        request.auth.uid == 'WUhNUBzjE7TVpU2PgV6ATjsXk9J2' ||
        request.auth.uid == 'cgrizSOG69QiNquzKOA69ls8clFm'
      );
    }

    function ownUserRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // An `email` field must be '' or exactly one valid address (no lists,
    // `<`/`>`, quotes or whitespace; a dotted domain with a 2+ letter or
    // punycode TLD).
    // The same rule is written three times and must stay identical:
    //  - here;
    //  - src/app/utilities/email-validation.ts SINGLE_EMAIL_PATTERN (forms);
    //  - functions/src/email-builders.ts SINGLE_EMAIL_PATTERN (server emails).
    // RE2 has no lookahead, so the 254-character bound is a size() check.
    function isValidEmailOrEmpty(e) {
      return e == '' || (
        e is string &&
        e.size() <= 254 &&
        e.matches("^[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(?:[.][A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*@(?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?[.])+(?:[A-Za-z]{2,}|xn--[A-Za-z0-9-]*[A-Za-z0-9])$")
      );
    }

    // The email guard, added alongside each create/update rule's own
    // authorization condition (which is unchanged). It checks an email only
    // when it is set or changed, so a doc that already stores an invalid
    // value (from before this rule) still accepts unrelated writes.
    //  - Create: no `email` field, '' or one valid address. `null` is denied:
    //    no client path creates a member or user with a null email (add-member
    //    and edit-member default to '', addGroup and createUserIfNotExists
    //    copy a string).
    //  - Update: passes when `email` is not among the changed keys (so a
    //    stored null or invalid value survives); otherwise the new value must
    //    pass the create check. Setting an email to null is denied; '' is
    //    how an email is cleared. Removing the field is allowed, as on create.
    //    resource.data.email is never read (it may be missing or null).
    function emailCreateValid() {
      return !('email' in request.resource.data) ||
        isValidEmailOrEmpty(request.resource.data.email);
    }

    function emailUpdateValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']) ||
        emailCreateValid();
    }

    // Email ownership for users/{uid} (Plan 4 B14), alongside the format
    // guard above. Invited members are linked to accounts by
    // users.emailLower (member.service's client lookups, the admin orphan
    // repair) and by the caller's token (the linkInvitedMembers callable),
    // so a client may store in a profile only '' or the caller's own
    // VERIFIED sign-in address (request.auth.token.email with
    // email_verified == true), compared case-insensitively. Without this,
    // anyone could write someone else's address into their own profile, the
    // syncUserEmailLower trigger would copy it into emailLower, and the next
    // invite lookup would link that person's pending member to them.
    //  - emailLower is held to the same address, lowercased. No client path
    //    writes it: the syncUserEmailLower trigger (Admin SDK) maintains it.
    //  - Like the format guard, a field is checked only when it is set
    //    (create) or changed (update), so unrelated writes to a doc with an
    //    older stored value still pass. Removing a field is allowed.
    //  - '' is how a profile email is cleared (and what an unverified
    //    sign-up stores, createUserProfileOnSignUp).
    function isOwnVerifiedEmail(e) {
      return e is string &&
        request.auth.token.email_verified == true &&
        e.lower() == request.auth.token.email.lower();
    }
    function userEmailFieldsOwned(changed) {
      return (!changed.hasAny(['email']) ||
          !('email' in request.resource.data) ||
          request.resource.data.email == '' ||
          isOwnVerifiedEmail(request.resource.data.email)) &&
        (!changed.hasAny(['emailLower']) ||
          !('emailLower' in request.resource.data) ||
          request.resource.data.emailLower == '' ||
          (request.auth.token.email_verified == true &&
            request.resource.data.emailLower == request.auth.token.email.lower()));
    }
    function userEmailCreateOwned() {
      return userEmailFieldsOwned(request.resource.data.keys());
    }
    function userEmailUpdateOwned() {
      return userEmailFieldsOwned(request.resource.data.diff(resource.data).affectedKeys());
    }

    // Deny all client access to the mail collection.
    // The Firebase Trigger Email extension (Admin SDK) bypasses these rules,
    // so Cloud Functions can still write here. This prevents authenticated
    // users from sending spam via the app's SMTP account. The admin Mail
    // tab reads/deletes from the client (admin-mail.service.ts), so the
    // admin UID gets an explicit exception, mirroring app_errors below.
    match /mail/{document} {
      allow write: if false;
      allow read, delete: if isAdminUser();
    }

    // app_errors: client writes are blocked — the logAppError Cloud Function
    // (Admin SDK) handles all inserts, bypassing these rules. Only the admin
    // can read or delete (via the Error Log admin tab).
    match /app_errors/{document} {
      allow write: if false;
      allow read, delete: if isAdminUser();
    }

    // Plan 4 B19's group-email change (functions/src/member-email.ts):
    // pending confirmation tokens (keyed by sha256 of the mailed token) and
    // per-uid request counters. Server-only: the callables use the Admin
    // SDK, and no client may read a token or reset its own limit.
    match /memberEmailChangeTokens/{tokenId} {
      allow read, write: if false;
    }
    match /memberEmailChangeLimits/{uid} {
      allow read, write: if false;
    }

    // admin_config: admin-only. Cloud Functions use the Admin SDK and bypass
    // these rules; this prevents regular users from reading or modifying
    // alert configuration.
    match /admin_config/{document} {
      allow read, write: if isAdminUser();
    }

    // groups/{groupId} and its subcollections are scoped to group members,
    // via three arrays denormalized onto the group doc by the
    // syncGroupMemberUids Cloud Function trigger (functions/src/index.ts) -
    // rules can't query the members subcollection to answer "is this uid a
    // member/active member/admin of this group", so membership is
    // maintained server-side instead.
    //  - memberUids: everyone ever linked here. Used ONLY for the group
    //    doc's own read/list below - a member who left keeps just enough
    //    access to see the group's name (for the self-service "rejoin"
    //    dropdown, account-group-membership.component.ts) and nothing else.
    //    A left member has NO access to any subcollection - see
    //    activeMemberUids below.
    //  - activeMemberUids: memberUids currently active === true. Gates BOTH
    //    read and write on every subcollection - leaving a group revokes
    //    all access to its data, not just write access.
    //  - adminUids: activeMemberUids currently groupAdmin === true (group
    //    settings updates, and admin-only subcollection actions - see below).
    match /groups/{groupId} {
      function group(gid) {
        return get(/databases/$(database)/documents/groups/$(gid)).data;
      }
      function isActiveMember(gid) {
        return isSignedIn() && request.auth.uid in group(gid).activeMemberUids;
      }
      function isGroupAdmin(gid) {
        return isSignedIn() && request.auth.uid in group(gid).adminUids;
      }

      // This document's own read/list/create/update rules work directly
      // off resource.data / request.resource.data - it IS the document
      // being evaluated, so no extra get() is needed here (the helpers
      // above are for the subcollections below, which need to look at
      // their *parent* group doc). Deliberately the only place memberUids
      // (rather than activeMemberUids) grants anything - see the comment
      // above.
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      // Must match the where('memberUids', 'array-contains', uid) query's
      // own filter field exactly, or Firestore rejects the query outright.
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if isSignedIn() &&
        request.resource.data.memberUids == [request.auth.uid] &&
        request.resource.data.activeMemberUids == [request.auth.uid] &&
        request.resource.data.adminUids == [request.auth.uid];
      // Clients (including admins) must never edit the membership arrays -
      // only the syncGroupMemberUids trigger may.
      allow update: if isGroupAdmin(groupId) &&
        request.resource.data.memberUids == resource.data.memberUids &&
        request.resource.data.activeMemberUids == resource.data.activeMemberUids &&
        request.resource.data.adminUids == resource.data.adminUids;
      // deleteGroup Cloud Function (Admin SDK) handles deletion.
      allow delete: if false;

      // Add/remove/promote-to-admin are admin-only in the UI (members.component
      // .html's Add Member button, edit-member.component.html's groupAdmin
      // toggle) with NO defense-in-depth in the mutating methods themselves -
      // without this rule, any active member could directly add/remove
      // members or self-promote to admin via the SDK, bypassing the UI
      // entirely. A member may still write their own record (see
      // memberSelfUpdateValid), but only in the shapes the app's own
      // self-service paths use.
      match /members/{memberId} {
        // A non-admin's write to their OWN member doc (userRef is the
        // caller). Every self-write path in the app, and what it changes:
        //  - edit-member's Save on one's own row (updateMember):
        //    displayName; it also sends active and groupAdmin, but
        //    unchanged (the toggles are hidden from non-admins and the
        //    groupAdmin toggle is disabled on one's own row). A changed
        //    email goes through the requestMemberEmailChange callable
        //    instead (B19, below);
        //  - leaveGroup() with splits: active false, leftGroup true,
        //    groupAdmin false (without splits it deletes the doc instead);
        //  - rejoinGroup(): leftGroup false, active true.
        // Account > Profile's Sync and the group email update dialog go
        // through the updateMemberEmails callable (Admin SDK), so no
        // self-write changes email. A self-write may change only those four
        // fields (userRef, email, emailLower and invite are server- or
        // admin-written), and:
        //  - may never grant groupAdmin: syncGroupMemberUids copies it into
        //    adminUids, which is a full admin (deleteGroup included). Clearing
        //    it (leaveGroup) is fine.
        //  - may set active to true only by rejoining after leaving
        //    voluntarily (leftGroup == true). A member an admin deactivated
        //    is reactivated by an admin; Member.leftGroup exists for exactly
        //    this distinction.
        //  - may set leftGroup to true only when leaving, i.e. from an active
        //    membership and together with active false. Otherwise a
        //    deactivated member could "leave" and then "rejoin" themselves.
        // Fields are read with get(): legacy docs may lack leftGroup.
        function memberSelfUpdateValid() {
          let before = resource.data;
          let after = request.resource.data;
          return before.get('userRef', null) == ownUserRef() &&
            after.diff(before).affectedKeys()
              .hasOnly(['displayName', 'active', 'leftGroup', 'groupAdmin']) &&
            !(after.get('groupAdmin', false) == true &&
              before.get('groupAdmin', false) != true) &&
            !(after.get('active', false) == true &&
              before.get('active', false) != true &&
              before.get('leftGroup', false) != true) &&
            !(after.get('leftGroup', false) == true &&
              before.get('leftGroup', false) != true &&
              (before.get('active', false) != true ||
                after.get('active', false) == true));
        }

        // Plan 4 B19: a LINKED member's `email` is always an address the
        // linked user has proven they own, because all group mail goes to
        // member.email (functions/src/group-mail-recipient.ts). It holds
        // because it is only ever:
        //  - the linked user's profile email when the link is written (the
        //    profile email is '' or their verified sign-in address, B14):
        //    add-member's and edit-member's auto-link by email
        //    (addMemberToGroup / updateMemberWithUserMatching), and the
        //    creator's own row in addGroup;
        //  - an address they confirmed through a link mailed to it, or their
        //    verified address, written by the requestMemberEmailChange /
        //    confirmMemberEmailChange / updateMemberEmails callables (Admin
        //    SDK), which also check for duplicates in the group and cancel
        //    the row's pending confirmation links;
        //  - written with the link by linkInvitedMembers / the admin orphan
        //    repair (Admin SDK), which match the verified address.
        // Without this, an admin could create a member with a victim's
        // userRef and an address of their choosing and have group mail sent
        // there (final review I2). So:
        //  - create with userRef set: the email must equal (ignoring case)
        //    the linked users doc's `email` (not emailLower, which a trigger
        //    fills in later), which must be non-empty. The caller's own row
        //    (addGroup's creator) may instead carry '' or their verified
        //    sign-in address (add-group stores '' for a legacy profile email
        //    that fails the single-address rule).
        //  - userRef: an admin may set it from null (the same email match on
        //    the resulting doc) or clear it; X to Y is denied, and a member
        //    never touches it (memberSelfUpdateValid).
        //  - email changed on an unlinked doc: admins only, as before (and
        //    the match above when the same write links it).
        //  - email changed on a linked doc: denied to every client, the
        //    member themself and admins alike (the edit-member dialog
        //    disables the field on someone else's linked row, and sends one's
        //    own change to requestMemberEmailChange). A direct self-write of
        //    the verified address was allowed until 2026-10-23 (Profile
        //    Sync); it skipped the duplicate check and left pending links
        //    alive (final re-review M1/M2), so it moved to updateMemberEmails.
        //  - emailLower: no client writes it (syncMemberEmailLower does), but
        //    a client write that sets it must hold email lowercased, since
        //    linkInvitedMembers links by it.
        // userRef must name a users/{uid} doc: r[4] is its last segment, so
        // any other path (a member doc that also has an `email`) fails.
        function isUserDocRef(r) {
          return r is path &&
            r == /databases/$(database)/documents/users/$(r[4]);
        }
        function emailMatchesLinkedUser(data) {
          let r = data.get('userRef', null);
          let e = data.get('email', '');
          return isUserDocRef(r) && e is string && e != '' &&
            get(r).data.get('email', '') is string &&
            e.lower() == get(r).data.get('email', '').lower();
        }
        function isOwnRowWithOwnEmail(data) {
          let e = data.get('email', '');
          return data.get('userRef', null) == ownUserRef() &&
            (e == '' || isOwnVerifiedEmail(e));
        }
        function memberEmailLowerValid(changed) {
          let after = request.resource.data;
          return !changed.hasAny(['emailLower']) ||
            !('emailLower' in after) ||
            (after.get('email', '') is string &&
              after.emailLower == after.get('email', '').lower());
        }
        function memberLinkCreateValid() {
          let after = request.resource.data;
          return after.get('userRef', null) == null ||
            emailMatchesLinkedUser(after) ||
            isOwnRowWithOwnEmail(after);
        }
        function memberLinkUpdateValid() {
          let before = resource.data;
          let after = request.resource.data;
          let changed = after.diff(before).affectedKeys();
          let beforeRef = before.get('userRef', null);
          let afterRef = after.get('userRef', null);
          return (!changed.hasAny(['userRef']) ||
              (beforeRef == null && isGroupAdmin(groupId) &&
                emailMatchesLinkedUser(after)) ||
              (beforeRef != null && afterRef == null &&
                isGroupAdmin(groupId))) &&
            (!changed.hasAny(['email']) ||
              (beforeRef == null && isGroupAdmin(groupId) &&
                (afterRef == null || emailMatchesLinkedUser(after)))) &&
            memberEmailLowerValid(changed);
        }

        allow read: if isActiveMember(groupId);
        // Safe for the very first member of a brand-new group too: addGroup()
        // creates the group doc first (own write, awaited) and only then
        // creates the member doc, so isGroupAdmin(groupId)'s get() always
        // sees a group that genuinely exists by the time this runs - and the
        // creator is already in adminUids from that same group-creation write.
        allow create: if isGroupAdmin(groupId) && emailCreateValid() &&
          memberLinkCreateValid() &&
          memberEmailLowerValid(request.resource.data.keys());
        // The self clause does not require an active membership: it covers
        // a self-service write made *while inactive*: rejoinGroup() (the
        // exact state this write is trying to escape) - plus edit-member
        // self-edits and leaveGroup()'s own self-update. Its shape is limited by
        // memberSelfUpdateValid() above, and every update's userRef, email
        // and emailLower by memberLinkUpdateValid().
        allow update: if (isGroupAdmin(groupId) || memberSelfUpdateValid()) &&
          emailUpdateValid() && memberLinkUpdateValid();
        // Self-delete is leaveGroup() for a member with no splits. It only
        // removes the caller's own access (the member can't recreate it;
        // create is admin-only).
        allow delete: if isGroupAdmin(groupId) ||
          resource.data.userRef == ownUserRef();
      }

      // Admin-only in the UI (categories.component.html's Add/Edit gating)
      // with no defense-in-depth in addCategory()/EditCategoryComponent -
      // and no legitimate non-admin write path exists (the initial "Default"
      // category is created by addGroup()'s creator, who is always admin).
      match /categories/{categoryId} {
        allow read: if isActiveMember(groupId);
        allow write: if isGroupAdmin(groupId);
      }

      match /expenses/{expenseId} {
        allow read, write: if isActiveMember(groupId);
      }

      // Deliberately NOT split by admin/active-member: the admin-only "mark
      // paid/unpaid" correction (expenses.component.ts's markSplitPaidUnpaid)
      // and the ordinary settle-up flow (split.service.ts's
      // paySplitsBetweenMembers/settleGroup, any active member) both write
      // the identical {paid: bool} shape to the same fields - a rule can't
      // tell "an admin correcting" from "a member settling their own split"
      // apart, and there's no real security boundary being crossed if a
      // non-admin bypasses the UI to flip their own split's paid status
      // directly, since they could reach the same state through settle-up
      // anyway.
      match /splits/{splitId} {
        allow read, write: if isActiveMember(groupId);
      }

      // Unlike splits, history CAN be cleanly split: a history doc is only
      // ever created via the legitimate settle-up flow (split.service.ts,
      // any active member) and only ever updated/deleted via the admin-only
      // "unpay" reversal (history.service.ts has exactly three methods -
      // unpayHistory, unpaySingleSplitFromHistory, unpayGroupSettle - and
      // nothing else touches an existing history doc).
      match /history/{historyId} {
        allow read, create: if isActiveMember(groupId);
        allow update, delete: if isGroupAdmin(groupId);
      }

      match /memorized/{memorizedId} {
        allow read, write: if isActiveMember(groupId);
      }

      // Server-only (Admin SDK) - deny all client access.
      match /settleBatches/{batchId} {
        allow read, write: if false;
      }
    }

    // Collection-group listener at group.service.ts's getUserGroups (the
    // collectionGroup('members') where('userRef','==', user.ref) query).
    // Must match that query's own filter field exactly, same
    // query-validation reason as the groups list rule above - lets a user
    // read only their own member row, across every group, without a
    // cross-tenant grant.
    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn() && resource.data.userRef == ownUserRef();
    }

    // users/{uid}: profile, payment handles (venmoId, paypalId, cashAppId,
    // zelleId), emailOptOut, email and defaultGroupRef.
    //  - read: still open to any signed-in user. Members' payment handles
    //    and emailOptOut are read cross-user (user.service), and
    //    updateGroup() queries users by defaultGroupRef. Narrowing reads is
    //    the deferred read half of Phase 3 (.claude/firestore-rules-hardening.md).
    //  - create/delete: own doc only. No client path creates or deletes
    //    another user's doc; new profiles (createUserProfileOnSignUp) and
    //    account deletion run through the Admin SDK, which bypasses rules.
    //  - update: own doc, or a group admin clearing a default that points at
    //    their group. Two client paths write another user's doc, and both
    //    only set defaultGroupRef to null on a doc whose default is the
    //    caller's group: group.service updateGroup() (deactivate/archive, in
    //    the same writeBatch as the group update) and member.service
    //    removeMemberFromGroup(). The admin check reads the group's
    //    adminUids through get(), which sees the state before the batch;
    //    deactivating or archiving never changes adminUids, so it holds.
    //    Proved on the emulator by e2e/infra/user-rules.spec.ts.
    // Both keep the email format guard (emailCreateValid()/emailUpdateValid())
    // and add the ownership guard: a set or changed email/emailLower must be
    // '' or the caller's own verified address (userEmailCreateOwned()/
    // userEmailUpdateOwned(); proved by e2e/infra/email-rules.spec.ts).
    match /users/{userId} {
      function isOwnUserDoc() {
        return isSignedIn() && request.auth.uid == userId;
      }
      function isAdminClearingDefaultGroup() {
        return isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['defaultGroupRef']) &&
          request.resource.data.defaultGroupRef == null &&
          resource.data.get('defaultGroupRef', null) != null &&
          request.auth.uid in get(resource.data.defaultGroupRef).data.adminUids;
      }

      allow read: if isSignedIn();
      allow create: if isOwnUserDoc() && emailCreateValid() &&
        userEmailCreateOwned();
      allow update: if (isOwnUserDoc() || isAdminClearingDefaultGroup()) &&
        emailUpdateValid() && userEmailUpdateOwned();
      allow delete: if isOwnUserDoc();
    }
  }
}
