{
  "name": "pipsplit",
  "version": "1.26.12",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "start": "ng serve --host=127.0.0.1 --port=4200",
    "kill-ports": "pnpx kill-port 4000 && pnpx kill-port 4500 && pnpx kill-port 5000 && pnpx kill-port 8080 && pnpx kill-port 9099 && pnpx kill-port 9150 && pnpx kill-port 9199",
    "kill-test-ports": "node scripts/test-env/kill-test-ports.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "reset-packages": "rm -rf node_modules && rm -rf pnpm-lock.yaml && pnpm install",
    "get-indexes": "firebase firestore:indexes",
    "sync-indexes": "node scripts/updateFirestoreIndexes.js",
    "query": "pnpm --dir scripts/db query",
    "deps:dry-run": "dependabot-agent --dry-run",
    "deps:fix": "dependabot-agent",
    "emu": "node scripts/start-emulators.js --only auth,functions,firestore,hosting,storage",
    "emu:data": "node scripts/start-emulators.js --only auth,functions,firestore,hosting,storage --import seed-data",
    "emu:no-func": "node scripts/start-emulators.js --only auth,firestore,hosting,storage --import seed-data",
    "emu:seed": "pnpm --dir scripts/db seed",
    "emu:prune": "pnpm --dir scripts/db prune-expenses",
    "emu:export": "firebase emulators:export seed-data --force",
    "build:cap": "ng build --configuration=production && npx cap sync",
    "build:prod": "pnpm --no-git-tag-version version patch && node scripts/setBuildDate.js && node scripts/updatePrivacyDate.js && ng build --configuration=production && node scripts/generate-sitemap.js",
    "build:ci": "node scripts/setBuildDate.js && node scripts/updatePrivacyDate.js && ng build --configuration=production && node scripts/generate-sitemap.js",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:area": "node scripts/test-area/test-area.mjs",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install chromium",
    "e2e:local": "pnpm e2e",
    "e2e": "node scripts/test-env/with-test-emulators.mjs --build-functions -- playwright test",
    "e2e:headed": "node scripts/test-env/with-test-emulators.mjs --build-functions -- playwright test --headed",
    "e2e:ui": "node scripts/test-env/with-test-emulators.mjs --build-functions -- playwright test --ui",
    "e2e:debug": "node scripts/test-env/with-test-emulators.mjs --build-functions -- playwright test --debug",
    "screenshots:feature-tour": "playwright test -c e2e/feature-tour/playwright.feature-tour.config.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.3",
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor-firebase/analytics": "^8.5.2",
    "@capacitor-firebase/app-check": "8.5.2",
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/text-zoom": "^8.0.1",
    "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.8",
    "@ngrx/signals": "^22.0.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "bootstrap": "^5.3.8",
    "firebase": "^13.0.0",
    "moment": "^2.31.0",
    "replace-in-file": "^9.0.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "dependabot-agent": "^1.2.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "firebase-admin": "^14.5.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-eslint-cli": "^9.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.64.9",
    "@rollup/rollup-win32-x64-msvc": "^4.64.9"
  }
}
