{
  "name": "pipsplit",
  "version": "1.26.3",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "start": "ng serve --host=127.0.0.1 --port=4200",
    "kill-ports": "pnpx kill-port 4000 && pnpx kill-port 4500 && pnpx kill-port 5000 && pnpx kill-port 8080 && pnpx kill-port 9099 && pnpx kill-port 9150 && pnpx kill-port 9199",
    "reset-packages": "rm -rf node_modules && rm -rf pnpm-lock.yaml && pnpm install",
    "get-indexes": "firebase firestore:indexes",
    "sync-indexes": "node scripts/updateFirestoreIndexes.js",
    "query": "pnpm --dir scripts/db query",
    "deps:dry-run": "dependabot-agent --dry-run",
    "deps:fix": "dependabot-agent",
    "emu": "node scripts/start-emulators.js --only auth,functions,firestore,hosting,storage",
    "emu:data": "node scripts/start-emulators.js --only auth,functions,firestore,hosting,storage --import seed-data",
    "emu:no-func": "node scripts/start-emulators.js --only auth,firestore,hosting,storage --import seed-data",
    "emu:seed": "pnpm --dir scripts/db seed",
    "emu:prune": "pnpm --dir scripts/db prune-expenses",
    "emu:export": "firebase emulators:export seed-data --force",
    "build:cap": "ng build --configuration=production && npx cap sync",
    "build:prod": "pnpm --no-git-tag-version version patch && node scripts/setBuildDate.js && node scripts/updatePrivacyDate.js && ng build --configuration=production && node scripts/generate-sitemap.js",
    "build:ci": "node scripts/setBuildDate.js && node scripts/updatePrivacyDate.js && ng build --configuration=production && node scripts/generate-sitemap.js",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install",
    "e2e:ci": "cross-env CI=true playwright test",
    "e2e:ci:headed": "cross-env CI=true playwright test --headed",
    "e2e:ci:fast": "cross-env CI=true playwright test navigation.spec.ts auth-unauthenticated.spec.ts auth-authenticated.spec.ts --project=chromium",
    "e2e:local": "playwright test",
    "e2e:local:debug": "playwright test --debug",
    "e2e:local:ui": "playwright test --ui",
    "e2e:local:headed": "playwright test --headed",
    "e2e:local:fast": "playwright test navigation.spec.ts auth-unauthenticated.spec.ts auth-authenticated.spec.ts --project=chromium",
    "e2e:local:fast:headed": "playwright test navigation.spec.ts auth-unauthenticated.spec.ts auth-authenticated.spec.ts --project=chromium --headed",
    "screenshots:feature-tour": "playwright test -c e2e/feature-tour/playwright.feature-tour.config.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-server": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/ssr": "^22.2.1",
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor-firebase/analytics": "^8.5.2",
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/text-zoom": "^8.0.1",
    "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.8",
    "@ngrx/signals": "^22.0.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "bootstrap": "^5.3.8",
    "firebase": "^12.19.0",
    "moment": "^2.31.0",
    "replace-in-file": "^9.0.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dependabot-agent": "^1.2.0",
    "dotenv": "^18.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-eslint-cli": "^9.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.64.0",
    "@rollup/rollup-win32-x64-msvc": "^4.64.0"
  }
}
