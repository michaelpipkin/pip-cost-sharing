rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Receipt images/PDFs, scoped to ACTIVE group membership via the
    // activeMemberUids array firestore.rules maintains on the group doc
    // (see functions/src/index.ts's syncGroupMemberUids) - a member who
    // left the group loses read access here too, same as every Firestore
    // subcollection (leaving revokes all access to group data, not just
    // write access). This is the only path the client ever writes -
    // confirmed via grep across expense.service.ts's
    // addExpense/updateExpense/deleteExpense, which all use this exact
    // path shape. scanReceipt (OCR) doesn't touch Storage at all, so it's
    // unaffected either way.
    match /groups/{groupId}/receipts/{expenseId} {
      allow read, delete: if request.auth != null &&
        request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(groupId)).data.activeMemberUids;
      allow write: if request.auth != null &&
        request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(groupId)).data.activeMemberUids &&
        request.resource.size < 5 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
        request.resource.contentType.matches('application/pdf'));
    }
  }
}
