{
  "name": "functions",
  "version": "1.0.5",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "reset-packages": "rm -rf node_modules && rm -rf pnpm-lock.yaml && pnpm install",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "pnpm build && firebase emulators:start --only functions",
    "shell": "pnpm build && firebase functions:shell",
    "start": "pnpm shell",
    "deploy-functions": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node ../scripts/test-env/with-test-emulators.mjs --only auth,firestore,storage -- pnpm --dir functions exec vitest run",
    "test:watch": "node ../scripts/test-env/with-test-emulators.mjs --only auth,firestore,storage -- pnpm --dir functions exec vitest"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.5",
    "@google-cloud/secret-manager": "^7.2.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "nodemailer": "^10.4.0",
    "pdfjs-dist": "^6.5.438",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/app": "^0.16.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.32.0",
    "firebase-functions-test": "^3.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "private": true
}